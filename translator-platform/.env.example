# Translator Platform Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL async connection string
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://translator:translator@localhost:5432/translator_db

# Redis connection string
# Format: redis://[:password]@host:port/db
REDIS_URL=redis://localhost:6379/0

# ============================================
# SECURITY CONFIGURATION
# ============================================
# Secret key for JWT token signing (generate with: openssl rand -hex 32)
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# JWT Algorithm
ALGORITHM=HS256

# Access token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiration in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing rounds (bcrypt)
BCRYPT_ROUNDS=12

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ============================================
# AI MODEL CONFIGURATION
# ============================================
# Directory for cached models
MODEL_CACHE_DIR=./models

# IndicTrans2 model path (distilled models for CPU)
INDIC_TRANS2_MODEL_PATH=./models/indictrans2

# Faster-Whisper model path
WHISPER_MODEL_PATH=./models/whisper

# Model device (cpu/cuda/mps)
MODEL_DEVICE=cpu

# Inference batch size
INFERENCE_BATCH_SIZE=1

# Max sequence length for translation
MAX_SEQ_LENGTH=512

# Enable INT8 quantization
ENABLE_INT8_QUANTIZATION=true

# Number of CPU threads for inference
CPU_THREADS=4

# ============================================
# INFERENCE QUEUE CONFIGURATION
# ============================================
# Maximum concurrent inference requests
MAX_CONCURRENT_INFERENCE=4

# Inference request timeout in seconds
INFERENCE_TIMEOUT=30

# Queue max size (0 = unlimited)
INFERENCE_QUEUE_MAX_SIZE=100

# ============================================
# REDIS CACHE CONFIGURATION
# ============================================
# Cache TTL for translations (seconds)
TRANSLATION_CACHE_TTL=3600

# Cache TTL for glossary lookups (seconds)
GLOSSARY_CACHE_TTL=7200

# Session cache TTL (seconds)
SESSION_CACHE_TTL=1800

# ============================================
# WEBSOCKET CONFIGURATION
# ============================================
# WebSocket ping interval (seconds)
WS_PING_INTERVAL=30

# WebSocket ping timeout (seconds)
WS_PING_TIMEOUT=10

# Max message size (bytes)
WS_MAX_MESSAGE_SIZE=1048576

# ============================================
# RATE LIMITING
# ============================================
# Requests per minute per IP
RATE_LIMIT_REQUESTS=60

# Rate limit window (seconds)
RATE_LIMIT_WINDOW=60

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# FRONTEND CONFIGURATION (Vite)
# ============================================
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_APP_TITLE=Translator Platform

# ============================================
# ADMIN INITIALIZATION
# ============================================
# Initial admin user (created on first run if not exists)
INIT_ADMIN_EMAIL=admin@translator.local
INIT_ADMIN_PASSWORD=change-me-immediately
INIT_ADMIN_FULL_NAME=System Administrator

# ============================================
# DOMAIN CONFIGURATION
# ============================================
# Default domains (comma-separated)
DEFAULT_DOMAINS=technology,medical,general

# ============================================
# SUPPORTED LANGUAGES
# ============================================
# Language codes: en, kn, hi, ml, ta
SUPPORTED_LANGUAGES=en,kn,hi,ml,ta

# Default source language
DEFAULT_SOURCE_LANG=en

# Default target language
DEFAULT_TARGET_LANG=kn